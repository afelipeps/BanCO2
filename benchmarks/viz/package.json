{
  "name": "banco2-bench-viz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Aislado: benchmark de candidatos de visualización para F3. NO production code.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:baseline": "vite build --mode baseline",
