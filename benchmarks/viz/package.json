    "typecheck": "tsc --noEmit",
    "measure": "node scripts/measure_bundle.mjs"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "react": "^19.2.3",
